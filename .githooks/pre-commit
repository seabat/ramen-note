#!/bin/sh
# commit 前の ktlint 整形 + rules-reviewer レビュー。
#
# 1. ステージ済みファイルに *.kt が含まれる場合のみ ktlintFormat を実行する
#    （Claude Code の Hook ではなく git 標準の pre-commit に統一。旧来
#    .claude/settings.json 側にあった同等の処理は削除済み）
# 2. 整形によってファイルが変化した場合は、変化分を再ステージした上で
#    commit を中止する（レビューは実行しない）。ステージ内容が整形前後で
#    変わってしまい、何をレビューすべきか曖昧になるため。開発者は差分を
#    確認して再度 commit すればよい（次回は整形差分が出ないためそのまま
#    ステップ3に進む）
# 3. 整形で変化がなければ、.claude/skills/rules-reviewer/SKILL.md が定義する
#    6ルール（coding-conventions / di-koin / navgraph-preview /
#    platform-specific / ai-implementation / secrets）に関連しそうな
#    ファイルがステージされている場合のみ、Claude Code をヘッドレス実行して
#    レビューし、FAIL が1件でもあれば commit を中止する
#
# 有効化（開発者ごとに1回、クローン後に実行）:
#   git config core.hooksPath .githooks
#
# 緊急時に全体を飛ばす場合:
#   git commit --no-verify

set -eu

STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# --- ステップ1/2: ktlint 整形 ---

if echo "$STAGED_FILES" | grep -qE '\.kt$'; then
  echo "pre-commit: ステージに *.kt が含まれるため ktlintFormat を実行します..."

  BEFORE_STATUS=$(git status --porcelain)
  ./gradlew ktlintFormat --rerun-tasks
  AFTER_STATUS=$(git status --porcelain)

  if [ "$BEFORE_STATUS" != "$AFTER_STATUS" ]; then
    git add -u
    echo "" >&2
    echo "pre-commit: ktlintFormat がファイルを整形したため commit を中止しました。" >&2
    echo "  整形済みの変更は再ステージ済みです。差分を確認し、再度 'git commit' してください。" >&2
    echo "  （整形で変化がなければ、その回はそのままレビューへ進みます）" >&2
    exit 1
  fi
fi

# --- ステップ3: rules-reviewer 対象判定（コスト削減のための高速フィルタ） ---

# ktlintFormat で git add -u は発生していない想定だが、念のため最新のステージ内容を取り直す。
STAGED_FILES=$(git diff --cached --name-only)

# rules-reviewer の6ルールの対象ファイルパターン（SKILL.md ステップ2と同じ内容）。
# ここでの判定はコスト削減のための高速フィルタであり、最終判断は claude -p 側で行う。
PATTERN='(ViewModel(Contract)?\.kt$|UseCase(Contract)?\.kt$|Repository(Contract)?\.kt$|DataSource.*\.kt$|Config.*\.kt$|\.common\.kt$|\.android\.kt$|\.ios\.kt$|Screen\.kt$|ViewModelModule\.kt$|DomainModule\.kt$|DataModule\.common\.kt$|UiModule\.common\.kt$|build\.gradle\.kts$|local\.properties$|google-services\.json$|\.env$|\.swift$)'

if ! echo "$STAGED_FILES" | grep -qE "$PATTERN"; then
  exit 0
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "rules-reviewer: claude コマンドが見つからないため commit を中止します。" >&2
  echo "  (Claude Code が未インストール、または PATH が通っていません)" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "rules-reviewer: jq コマンドが見つからないため commit を中止します。" >&2
  exit 1
fi

echo "rules-reviewer: 対象ファイルを検出しました。レビューを実行します（数十秒かかる場合があります）..."

# 注意: プロンプトは "/rules-reviewer ..." を先頭に単独で置く必要がある。
# 前後に他の文言を混ぜると「Unknown command: /rules-reviewer」としてスキルが解決されない
# （動作検証済み）。マーカー出力の指示は SKILL.md 側の --staged 分岐に既に含まれているため、
# ここで追加の指示文を足す必要はない。
PROMPT='/rules-reviewer --staged'

STDOUT_FILE=$(mktemp)
STDERR_FILE=$(mktemp)
trap 'rm -f "$STDOUT_FILE" "$STDERR_FILE"' EXIT

# 注意: stdout/stderr は必ず分離してファイルに書き出す。$(...) 経由で変数に
# 取り込んでから echo で jq に渡すと、/bin/sh（dash 等）の echo がバックスラッシュ
# エスケープ（JSON文字列中の \n 等）を解釈してJSONを破壊し jq が失敗する
# （動作検証済みの不具合）。jq には必ずファイルを直接読ませること。
set +e
claude -p "$PROMPT" \
  --allowedTools "Read,Glob,Bash" \
  --permission-prompts none \
  --output-format json \
  --max-budget-usd 2.00 \
  > "$STDOUT_FILE" 2> "$STDERR_FILE"
STATUS=$?
set -e

if [ "$STATUS" -ne 0 ]; then
  echo "rules-reviewer: claude -p の実行に失敗したため commit を中止します（ネットワーク・認証エラー等の可能性）。" >&2
  cat "$STDERR_FILE" >&2
  cat "$STDOUT_FILE" >&2
  exit 1
fi

RESULT_TEXT=$(jq -r '.result // empty' "$STDOUT_FILE" 2>/dev/null || true)

if [ -z "$RESULT_TEXT" ]; then
  echo "rules-reviewer: レビュー結果を取得できなかったため commit を中止します。" >&2
  cat "$STDOUT_FILE" >&2
  exit 1
fi

printf '%s\n' "$RESULT_TEXT"
echo ""

if printf '%s' "$RESULT_TEXT" | grep -q "RULES_REVIEW_RESULT: FAIL"; then
  echo "rules-reviewer で FAIL が検出されたため commit を中止しました。" >&2
  echo "  修正するか、緊急時は 'git commit --no-verify' で回避してください。" >&2
  exit 1
fi

if ! printf '%s' "$RESULT_TEXT" | grep -q "RULES_REVIEW_RESULT: PASS"; then
  echo "rules-reviewer: 判定マーカーが出力されなかったため commit を中止します。" >&2
  exit 1
fi

exit 0
